# ============================================================
# Variables d'environnement — API Collège Madeleine Daniélou
# Copier en .env puis adapter. NE JAMAIS COMMITTER .env
# ============================================================

# Port d'écoute de l'API
PORT=4000

# Origines autorisées (CORS restreint) — séparées par des virgules
CLIENT_URL=http://localhost:5173,https://madeleinedanielou.ci

# Authentification administrateur (JWT + bcrypt)
JWT_SECRET=CHANGEZ_MOI_par_une_chaine_aleatoire_de_64_caracteres
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=admin@madeleinedanielou.ci
ADMIN_PASSWORD=Secret@2026!

# reCAPTCHA v3 (Google) — laisser vide en développement
RECAPTCHA_SECRET=

# Limite de taille des fichiers uploadés (Mo)
UPLOAD_MAX_MB=20
