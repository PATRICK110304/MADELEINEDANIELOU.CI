# ============================================================
# Variables d'environnement — API GSMD Abidjan
# Copier en .env puis adapter. NE JAMAIS COMMITTER .env
# Génère les secrets avec : npm --workspace server run secrets
# ============================================================

# Port d'écoute de l'API (fourni par l'hébergeur en production)
PORT=4000

# Origines autorisées (CORS) — liste séparée par des virgules
CLIENT_URL=http://localhost:5173,https://madeleinedanielou.ci,https://www.madeleinedanielou.ci

# ---------- Base de données PostgreSQL (obligatoire) ----------
# Local   : postgresql://postgres:postgres@localhost:5432/gsmd
# Managé  : postgresql://user:password@host:5432/db?sslmode=require
#
# Exemple Supabase (pooler transactionnel, IPv4) — REMPLACEZ [PASSWORD]
# par le mot de passe de la base, encodé en URL s'il contient des
# caractères spéciaux. Ne jamais committer ce mot de passe.
# DATABASE_URL=postgresql://postgres.ldvzwxhscuppqpqrgnmf:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# Pour les migrations, le pooler en mode session (port 5432) est
# préférable ; notre script db:import utilisera DATABASE_URL.
DATABASE_URL=postgresql://user:password@localhost:5432/gsmd

# ---------- Supabase Auth (optionnel) ----------
# Uniquement la clé PUBLISHABLE : la clé secrète / service_role ne
# doit JAMAIS être mise dans .env ni dans le code de l'API publique.
# L'administrateur doit être créé dans Supabase Dashboard → Authentication
# avec la même adresse que ADMIN_EMAIL ci-dessous.
SUPABASE_URL=https://ldvzwxhscuppqpqrgnmf.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_w2ZTE_0EP253yHr3FtKPzg__1NRpwvY

# ---------- Authentification (mode repli JWT local) ----------
JWT_SECRET=CHANGEZ_MOI_par_une_chaine_aleatoire_de_64_caracteres
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=admin@madeleinedanielou.ci
ADMIN_PASSWORD=CHANGEZ_MOI_avec_un_mot_de_passe_fort
# Rôles autorisés (optionnel) : direction,secrétariat,communication
# Laisser vide pour n'autoriser que l'adresse ADMIN_EMAIL.
ADMIN_ROLES=

# ---------- Stockage cloud (optionnel) ----------
# Laissé vide = stockage local sous server/public/ (développement).
# Renseigné = Cloudinary ; les URL complètes sont alors enregistrées en base.
# Format : cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
CLOUDINARY_URL=

# ---------- Email de contact ----------
# Resend (recommandé) : clé API + domaine vérifié dans Resend.
# Sans RESEND_API_KEY, repli SMTP générique. Sans rien, les messages
# restent enregistrés en base (emailSent:false).
RESEND_API_KEY=
CONTACT_EMAIL_TO=groupescolaire@madeleinedanielou.ci
CONTACT_EMAIL_FROM=Groupe Scolaire Daniélou <groupescolaire@madeleinedanielou.ci>

# Repli SMTP (ex. Resend en SMTP si RESEND_API_KEY est vide)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------- Divers ----------
RECAPTCHA_SECRET=
UPLOAD_MAX_MB=20
